/**
 * Contenedor fijo del mapa. El canvas es decorativo (aria-hidden): cada paso describe en
 * texto lo que muestra el mapa, y la versión /texto ofrece todo el contenido (§11).
 */
---

<div class="story__map" aria-hidden="true">
  <div id="story-map" class="absolute inset-0"></div>
  <p class="story__map-status">Cargando el mapa…</p>
</div>
