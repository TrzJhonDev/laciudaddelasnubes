---
import { getCollection, render } from 'astro:content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Chapter from '@/components/story/Chapter.astro';
import StickyMap from '@/components/story/StickyMap.astro';
import FrisoRombos from '@/components/svg/FrisoRombos.astro';
import MapModeToggle from '@/components/ui/MapModeToggle.astro';
import ProgressBar from '@/components/ui/ProgressBar.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildStoryData } from '@/scripts/story/data';
import '@/styles/story.css';

const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(chapters.map(async (c) => ({ c, ...(await render(c)) })));
const storyData = buildStoryData(
  chapters.map((c) => ({ slug: c.data.slug, camera: c.data.camera, steps: c.data.steps })),
);

// Capturas del modo lite, generadas con `pnpm lite` (scripts/gen-lite.mjs).
interface LiteManifest {
  satelite: boolean;
  claves: string[];
}
let lite: LiteManifest = { satelite: false, claves: [] };
try {
  lite = JSON.parse(readFileSync(join(process.cwd(), 'public/lite/capturas.json'), 'utf8'));
} catch {
  // Aún no se han generado: el modo lite muestra solo el fondo del panel.
}
const generated = new Set(lite.claves);
const needed = new Set(storyData.steps.map((s) => s.liteKey));
storyData.liteReady = [...needed].filter((k) => generated.has(k));
const missing = needed.size - storyData.liteReady.length;
if (missing > 0) {
  console.warn(`[lite] faltan ${missing} de ${needed.size} capturas: ejecuta \`pnpm lite\``);
}
const liteAttribution = `Mapa: © OpenStreetMap · Protomaps · © Mapterhorn${
  lite.satelite ? ' · EOxCloudless (Copernicus Sentinel-2)' : ''
}`;
---

<BaseLayout
  title="Chachapoyas: tierra de los hombres de la neblina"
  description="Un recorrido interactivo por más de mil años de historia de Chachapoyas y su territorio: Kuélap, Karajía, Revash, la colonia y la independencia."
>
  <ProgressBar />
  <MapModeToggle />
  <div class="story">
    <StickyMap liteAttribution={liteAttribution} />

    <div class="story__content">
      <header class="story-hero" aria-labelledby="titulo">
        <div class="story-hero__mist" aria-hidden="true">
          <span data-mist></span>
          <span data-mist></span>
          <span data-mist></span>
        </div>
        <div class="story-hero__inner mx-auto max-w-3xl">
          <p class="font-mono text-sm tracking-[0.2em] text-ocre-500 uppercase" data-intro-fade>
            Amazonas · Perú
          </p>
          <h1 id="titulo" class="mt-4 font-light">
            <span class="hero-title block">Chachapoyas</span>
            <span class="mt-2 block text-h3 font-normal italic" data-intro-fade
              >tierra de los hombres de la neblina</span
            >
          </h1>
          <div data-intro-fade><FrisoRombos class="mx-auto mt-8" count={11} /></div>
          <p class="mt-6 text-sm" data-intro-fade>
            <a href="/texto" class="inline-flex min-h-touch items-center px-2 text-neblina-50"
              >Prefiero leer la versión de texto</a
            >
          </p>
        </div>
        <p class="story-hero__hint" data-scroll-hint>
          <span class="story-hero__hint-label">Desliza para comenzar</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
            <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </p>
      </header>

      {
        rendered.map(({ c, Content }) => (
          <Chapter
            slug={c.data.slug}
            order={c.data.order}
            title={c.data.title}
            kicker={c.data.kicker}
            warning={c.data.warning}
          >
            <Content />
          </Chapter>
        ))
      }

      <footer class="chapter-intro">
        <div class="chapter-intro__card">
          <h2 class="text-h3">Fuentes y créditos</h2>
          <p class="mt-4 text-sm text-neblina-200">
            Cada dato de esta historia lleva su fuente. Los textos son un borrador pendiente de
            revisión por un especialista.
          </p>
          <p class="mt-4 flex flex-wrap justify-center gap-x-6">
            <a href="/creditos" class="inline-flex min-h-touch items-center text-neblina-50">Ver fuentes</a>
            <a href="/texto" class="inline-flex min-h-touch items-center text-neblina-50">Versión de texto</a>
          </p>
        </div>
      </footer>
    </div>
  </div>

  <script type="application/json" id="story-data" set:html={JSON.stringify(storyData)} />
  <script>
    import '@/scripts/story/main';
  </script>
</BaseLayout>
