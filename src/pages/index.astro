---
import FrisoRombos from '@/components/svg/FrisoRombos.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

// F0: portada provisional que muestra los tokens. El mapa y el scroll llegan en F2.
const chapters = [
  'El territorio de la neblina',
  'Los Chachapoya, guerreros de las nubes',
  'Kuélap, la ciudad sobre la montaña',
  'Los que custodian los acantilados',
  'El Tahuantinsuyo llega al norte',
  'San Juan de la Frontera',
  'La ciudad de los balcones',
  'Higos Urco: la libertad del norte',
  'Chachapoyas hoy',
];
---

<BaseLayout
  title="Chachapoyas: tierra de los hombres de la neblina"
  description="Un recorrido interactivo por más de mil años de historia de Chachapoyas y su territorio: Kuélap, Karajía, Revash, la colonia y la independencia."
  dark
>
  <section
    class="grid min-h-svh place-items-center px-4 pb-[max(2rem,env(safe-area-inset-bottom))] text-center"
    aria-labelledby="titulo"
  >
    <div class="mx-auto max-w-3xl">
      <p class="font-mono text-sm tracking-[0.2em] text-[var(--text-data)] uppercase">
        Amazonas · Perú
      </p>
      <h1 id="titulo" class="mt-4 font-light">
        Chachapoyas
        <span class="mt-2 block text-h3 font-normal italic">tierra de los hombres de la neblina</span>
      </h1>
      <FrisoRombos class="mx-auto mt-8" count={11} />
      <p class="mx-auto mt-8 max-w-[60ch] text-[var(--text-accent)]">
        Hay ciudades que se esconden entre las nubes. Pronto podrás recorrer aquí más de mil años
        de su historia.
      </p>
      <p class="mt-6">
        <a href="/texto" class="inline-flex min-h-touch items-center px-2">Leer la versión de texto</a>
      </p>
    </div>
  </section>

  <section class="bg-neblina-50 px-4 py-16 text-bosque-900" aria-labelledby="capitulos">
    <div class="mx-auto max-w-[60ch]">
      <h2 id="capitulos">Capítulos</h2>
      <ol class="mt-6 space-y-3">
        {
          chapters.map((c, i) => (
            <li class="flex gap-4">
              <span class="tabular font-mono text-ocre-700">{String(i + 1).padStart(2, '0')}</span>
              <span>{c}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
