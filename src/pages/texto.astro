---
import BaseLayout from '@/layouts/BaseLayout.astro';
// F3: este artículo se generará desde la colección "chapters" (mismo MDX que la experiencia).
---

<BaseLayout
  title="Versión de texto"
  description="La historia de Chachapoyas en formato de artículo accesible, sin mapa ni animaciones."
>
  <article class="mx-auto max-w-[65ch] px-4 py-16">
    <h1>Chachapoyas: tierra de los hombres de la neblina</h1>
    <p class="mt-6">
      Esta es la versión de solo texto de la experiencia. Se está preparando el contenido.
    </p>
    <p class="mt-6"><a href="/" class="inline-flex min-h-touch items-center">Volver a la experiencia</a></p>
  </article>
</BaseLayout>
