---
import BaseLayout from '@/layouts/BaseLayout.astro';
// F3: se generará automáticamente desde las colecciones "sources" y "media".
---

<BaseLayout
  title="Créditos y fuentes"
  description="Fuentes históricas, fotografías y licencias usadas en la historia interactiva de Chachapoyas."
>
  <article class="mx-auto max-w-[65ch] px-4 py-16">
    <h1>Créditos y fuentes</h1>
    <h2 class="mt-10">Cartografía</h2>
    <ul class="mt-4 list-disc space-y-2 ps-6">
      <li>Datos del mapa © colaboradores de OpenStreetMap, vía Protomaps.</li>
      <li>Relieve: Mapterhorn (Copernicus GLO-30).</li>
    </ul>
    <p class="mt-10"><a href="/" class="inline-flex min-h-touch items-center">Volver a la experiencia</a></p>
  </article>
</BaseLayout>
